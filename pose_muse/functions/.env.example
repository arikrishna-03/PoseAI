# PoseMuse Firebase Cloud Functions Configuration

# Anthropic Claude API Key (Required for production via Firebase Secret Manager: firebase functions:secrets:set ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model Name (Default: claude-sonnet-5-5 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Daily scan limit per user (default 30)
DAILY_LIMIT=30
